# OS
.DS_Store
Thumbs.db

# Node
node_modules/
dist/
*.log
npm-debug.log*
.npm/

# Daemon runtime data (task DB, evidence store, session/port files) —
# local-first, never committed. Written into <projectPath>/.attest/ for
# WHATEVER project the daemon is pointed at (packages/daemon/src/index.ts,
# src/db.ts) — this is deliberately "**/", not a single fixed path, since
# during testing that's fixtures/platformer-basic/.attest/, not
# packages/daemon/.attest/. The narrower pattern here originally missed
# that and would have committed a live sqlite file — caught before the
# first commit.
**/.attest/

# Claude-flow / tooling local state — not project content.
.claude-flow/

# Every fixture is its OWN git repository, not part of this one — spec §4
# requires every Attest-managed project to be a real git repo, and the
# daemon's checkpoint/rollback machinery needs that repo boundary to
# actually mean something. If this repo also tracked fixture files, git
# commands run with a fixture folder as cwd would silently walk up and
# find THIS repo instead — meaning a "checkpoint" or "rollback" of a
# fixture could touch Attest's own uncommitted source. See each fixture's
# own .gitignore for what's excluded inside its repo.
fixtures/*/

# Unity package meta noise (asmdef .meta files ARE tracked; these are not)
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
