{
  "name": "@attest/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Minimal `attest` CLI. Deliberately thin per the solo rescope (spec §12 'Solo-specific decisions'): MCP is the primary client, this is just status/run/rollback.",
  "type": "module",
  "bin": {
    "attest": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --experimental-strip-types src/cli.ts"
  },
  "dependencies": {
    "@attest/daemon": "0.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13"
  }
}
