{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://attest.dev/schemas/transaction.schema.json",
  "title": "Transaction",
  "description": "A single Unity-side structural mutation request/result pair. Spec §7 'Transaction model'. Sent daemon -> Unity package over the RPC connection defined in rpc.schema.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "idempotencyKey", "taskId", "projectRevision", "unityVersion",
    "packageSchemaVersion", "targetAssets", "operations", "sensitivity"
  ],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "idempotencyKey": {
      "type": "string",
      "description": "Stable across retries of the SAME logical operation after a domain-reload disconnect (spec §6). On reconnect, Unity replays its last idempotencyKey; the daemon decides re-issue vs. confirm vs. rollback based on whether it already has a result for this key."
    },
    "taskId": { "$ref": "common.schema.json#/$defs/id" },
    "projectRevision": {
      "type": "string",
      "description": "Git commit hash of the checkpoint this transaction is being applied against."
    },
    "unityVersion": { "type": "string", "pattern": "^\\d{4}\\.\\d+\\.\\d+f\\d+$" },
    "packageSchemaVersion": { "type": "string" },

    "targetAssets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/assetPath" }
    },
    "preconditions": {
      "type": "array",
      "items": { "$ref": "#/$defs/precondition" }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operation" }
    },
    "expectedMutationSet": {
      "type": "array",
      "description": "Assets Attest predicts will change. Reconciled against result.actualMutationSet — any asset in actual but not expected fails the transaction (spec §7).",
      "items": { "$ref": "common.schema.json#/$defs/assetPath" }
    },
    "sensitivity": { "$ref": "common.schema.json#/$defs/actionSensitivity" },

    "result": { "$ref": "#/$defs/result" }
  },

  "$defs": {
    "precondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "asset_exists", "asset_unchanged_since_checkpoint", "component_present",
            "property_equals", "no_compile_errors", "not_in_play_mode"
          ]
        },
        "target": { "type": "string" },
        "expected": {}
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "add_component", "remove_component", "set_property",
            "assign_reference", "create_prefab_variant", "apply_prefab_overrides",
            "create_scriptable_object", "add_input_action", "create_placeholder_asset",
            "patch_file", "create_file"
          ]
        },
        "target": { "type": "string" },
        "value": {},
        "reason": {
          "type": "string",
          "description": "One-line justification surfaced in the review UI (spec US-05)."
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "actualMutationSet", "compilationRequired"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["success", "precondition_failed", "partial_failure", "mutation_set_mismatch", "rolled_back"]
        },
        "modifiedAssets": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/assetPath" } },
        "createdAssets": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/assetPath" } },
        "deletedAssets": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/assetPath" } },
        "actualMutationSet": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/assetPath" } },
        "compilationRequired": { "type": "boolean" },
        "diagnostics": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "evidenceRefs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" } }
      }
    }
  }
}
