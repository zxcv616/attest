{
  "name": "attest",
  "private": true,
  "version": "0.0.0",
  "description": "Attest — a self-verifying agentic Unity development system",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "daemon": "npm run dev --workspace packages/daemon"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
